{
  "openapi": "3.0.1",
  "info": {
    "title": "BoardVerse API",
    "description": "Authentication API for BoardVerse",
    "version": "v1"
  },
  "paths": {
    "/api/Auth/register": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Đăng ký tài khoản người dùng mới vào hệ thống BoardVerse.",
        "requestBody": {
          "description": "Thông tin đăng ký của người dùng.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterRequestDto"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterRequestDto"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterRequestDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Đăng ký thành công."
          },
          "400": {
            "description": "Dữ liệu đầu vào không hợp lệ hoặc email/username đã tồn tại."
          },
          "500": {
            "description": "Lỗi hệ thống khi xử lý đăng ký."
          }
        }
      }
    },
    "/api/Auth/login": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Xác thực tài khoản và tạo token đăng nhập cho người dùng.",
        "requestBody": {
          "description": "Thông tin đăng nhập của người dùng.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequestDto"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequestDto"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequestDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Đăng nhập thành công, trả về access token và refresh token."
          },
          "401": {
            "description": "Thông tin đăng nhập không hợp lệ."
          },
          "429": {
            "description": "Vượt quá số lần đăng nhập cho phép."
          }
        }
      }
    },
    "/api/Auth/google-login": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Đăng nhập bằng tài khoản Google và phát hành token truy cập.",
        "requestBody": {
          "description": "Thông tin Google ID token.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GoogleAuthRequestDto"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/GoogleAuthRequestDto"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/GoogleAuthRequestDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Đăng nhập Google thành công."
          },
          "401": {
            "description": "Google token không hợp lệ hoặc thiếu dữ liệu bắt buộc."
          }
        }
      }
    },
    "/api/Auth/refresh-token": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Gia hạn access token bằng refresh token hợp lệ.",
        "requestBody": {
          "description": "Thông tin refresh token cần gia hạn.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RefreshTokenRequestDto"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/RefreshTokenRequestDto"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/RefreshTokenRequestDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Gia hạn token thành công."
          },
          "401": {
            "description": "Refresh token không hợp lệ hoặc đã hết hạn."
          },
          "404": {
            "description": "Không tìm thấy người dùng tương ứng với refresh token."
          }
        }
      }
    },
    "/api/Auth/logout": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Thu hồi refresh token của người dùng để kết thúc phiên đăng nhập.",
        "requestBody": {
          "description": "Thông tin refresh token cần thu hồi.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RefreshTokenRequestDto"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/RefreshTokenRequestDto"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/RefreshTokenRequestDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Đăng xuất thành công."
          },
          "400": {
            "description": "Dữ liệu yêu cầu không hợp lệ."
          }
        }
      }
    },
    "/api/Auth/send-email-verification": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Gửi mã xác minh email đến địa chỉ đã đăng ký của người dùng.",
        "requestBody": {
          "description": "Địa chỉ email cần nhận mã xác minh.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SendEmailVerificationRequestDto"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/SendEmailVerificationRequestDto"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/SendEmailVerificationRequestDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Gửi email xác minh thành công."
          },
          "404": {
            "description": "Không tìm thấy người dùng theo email."
          },
          "500": {
            "description": "Không gửi được email."
          }
        }
      }
    },
    "/api/Auth/verify-email": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Xác thực email của người dùng bằng mã xác minh đã nhận.",
        "requestBody": {
          "description": "Mã xác minh email.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/VerifyEmailRequestDto"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/VerifyEmailRequestDto"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/VerifyEmailRequestDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Xác minh email thành công."
          },
          "401": {
            "description": "Mã xác minh không hợp lệ hoặc đã hết hạn."
          }
        }
      }
    },
    "/api/Auth/request-password-reset": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Tạo yêu cầu đặt lại mật khẩu và gửi mã reset đến email người dùng.",
        "requestBody": {
          "description": "Địa chỉ email cần yêu cầu đặt lại mật khẩu.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RequestPasswordResetDto"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/RequestPasswordResetDto"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/RequestPasswordResetDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Gửi yêu cầu đặt lại mật khẩu thành công."
          },
          "403": {
            "description": "Email chưa được xác minh."
          },
          "404": {
            "description": "Không tìm thấy người dùng theo email."
          }
        }
      }
    },
    "/api/Auth/reset-password": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Đặt lại mật khẩu bằng mã xác minh đặt lại mật khẩu.",
        "requestBody": {
          "description": "Thông tin mã reset và mật khẩu mới.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ResetPasswordDto"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/ResetPasswordDto"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/ResetPasswordDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Đặt lại mật khẩu thành công."
          },
          "401": {
            "description": "Mã reset không hợp lệ hoặc đã hết hạn."
          }
        }
      }
    },
    "/api/Auth/change-password": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Thay đổi mật khẩu của tài khoản đang đăng nhập.",
        "requestBody": {
          "description": "Mật khẩu hiện tại và mật khẩu mới.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChangePasswordDto"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/ChangePasswordDto"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/ChangePasswordDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Đổi mật khẩu thành công."
          },
          "400": {
            "description": "Mật khẩu mới không hợp lệ hoặc tài khoản không có mật khẩu nội bộ."
          },
          "401": {
            "description": "Token không hợp lệ hoặc mật khẩu hiện tại không đúng."
          }
        }
      }
    },
    "/api/Auth/link-google": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Liên kết tài khoản Google với tài khoản BoardVerse hiện có.",
        "requestBody": {
          "description": "Google ID token dùng để liên kết tài khoản.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LinkGoogleRequestDto"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/LinkGoogleRequestDto"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/LinkGoogleRequestDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Liên kết tài khoản Google thành công."
          },
          "401": {
            "description": "Google token không hợp lệ."
          },
          "404": {
            "description": "Không tìm thấy tài khoản nội bộ để liên kết."
          }
        }
      }
    },
    "/api/Health/status": {
      "get": {
        "tags": [
          "Health"
        ],
        "summary": "Kiểm tra trạng thái hoạt động tổng thể của API.",
        "responses": {
          "200": {
            "description": "API đang hoạt động bình thường."
          }
        }
      }
    },
    "/api/Health/db-info": {
      "get": {
        "tags": [
          "Health"
        ],
        "summary": "Kiểm tra kết nối cơ sở dữ liệu và trả về số lượng người dùng hiện có.",
        "responses": {
          "200": {
            "description": "Kết nối cơ sở dữ liệu thành công."
          },
          "500": {
            "description": "Không truy cập được cơ sở dữ liệu."
          }
        }
      }
    },
    "/api/Health/ping": {
      "get": {
        "tags": [
          "Health"
        ],
        "summary": "Trả về phản hồi nhịp tim đơn giản để kiểm tra endpoint.",
        "responses": {
          "200": {
            "description": "Endpoint phản hồi bình thường."
          }
        }
      }
    },
    "/api/Protected/secret": {
      "get": {
        "tags": [
          "Protected"
        ],
        "summary": "Truy cập endpoint yêu cầu xác thực để xác minh token hợp lệ.",
        "responses": {
          "200": {
            "description": "Người dùng đã truy cập được endpoint bảo vệ."
          },
          "401": {
            "description": "Thiếu token hoặc token không hợp lệ."
          }
        }
      }
    },
    "/api/UserManagement/users": {
      "get": {
        "tags": [
          "UserManagement"
        ],
        "summary": "Lấy danh sách người dùng theo điều kiện tìm kiếm, lọc và phân trang.",
        "parameters": [
          {
            "name": "Search",
            "in": "query",
            "schema": {
              "maxLength": 100,
              "minLength": 0,
              "type": "string"
            }
          },
          {
            "name": "Role",
            "in": "query",
            "schema": {
              "maxLength": 32,
              "minLength": 0,
              "type": "string"
            }
          },
          {
            "name": "IsActive",
            "in": "query",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "IsBlocked",
            "in": "query",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "Page",
            "in": "query",
            "schema": {
              "maximum": 100,
              "minimum": 1,
              "type": "integer",
              "format": "int32"
            }
          },
          {
            "name": "PageSize",
            "in": "query",
            "schema": {
              "maximum": 100,
              "minimum": 1,
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Trả về danh sách người dùng phù hợp."
          },
          "401": {
            "description": "Thiếu token hoặc token không hợp lệ."
          },
          "403": {
            "description": "Người dùng không có quyền quản trị."
          }
        }
      }
    },
    "/api/UserManagement": {
      "get": {
        "tags": [
          "UserManagement"
        ],
        "summary": "Lấy danh sách người dùng theo điều kiện tìm kiếm, lọc và phân trang.",
        "parameters": [
          {
            "name": "Search",
            "in": "query",
            "schema": {
              "maxLength": 100,
              "minLength": 0,
              "type": "string"
            }
          },
          {
            "name": "Role",
            "in": "query",
            "schema": {
              "maxLength": 32,
              "minLength": 0,
              "type": "string"
            }
          },
          {
            "name": "IsActive",
            "in": "query",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "IsBlocked",
            "in": "query",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "Page",
            "in": "query",
            "schema": {
              "maximum": 100,
              "minimum": 1,
              "type": "integer",
              "format": "int32"
            }
          },
          {
            "name": "PageSize",
            "in": "query",
            "schema": {
              "maximum": 100,
              "minimum": 1,
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Trả về danh sách người dùng phù hợp."
          },
          "401": {
            "description": "Thiếu token hoặc token không hợp lệ."
          },
          "403": {
            "description": "Người dùng không có quyền quản trị."
          }
        }
      },
      "post": {
        "tags": [
          "UserManagement"
        ],
        "summary": "Tạo mới tài khoản người dùng cho quản trị viên.",
        "requestBody": {
          "description": "Thông tin tài khoản cần tạo.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AdminCreateUserDto"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/AdminCreateUserDto"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/AdminCreateUserDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          },
          "201": {
            "description": "Tạo người dùng thành công."
          },
          "400": {
            "description": "Dữ liệu đầu vào không hợp lệ hoặc email/username đã tồn tại."
          },
          "401": {
            "description": "Thiếu token hoặc token không hợp lệ."
          },
          "403": {
            "description": "Người dùng không có quyền quản trị."
          }
        }
      }
    },
    "/api/UserManagement/{id}": {
      "get": {
        "tags": [
          "UserManagement"
        ],
        "summary": "Lấy thông tin chi tiết của một người dùng theo mã định danh.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Mã định danh của người dùng.",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Trả về thông tin người dùng."
          },
          "404": {
            "description": "Không tìm thấy người dùng."
          }
        }
      },
      "put": {
        "tags": [
          "UserManagement"
        ],
        "summary": "Cập nhật thông tin người dùng theo mã định danh.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Mã định danh của người dùng.",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "description": "Thông tin cập nhật người dùng.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AdminUpdateUserDto"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/AdminUpdateUserDto"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/AdminUpdateUserDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Cập nhật người dùng thành công."
          },
          "404": {
            "description": "Không tìm thấy người dùng."
          },
          "401": {
            "description": "Thiếu token hoặc token không hợp lệ."
          },
          "403": {
            "description": "Người dùng không có quyền quản trị."
          }
        }
      },
      "delete": {
        "tags": [
          "UserManagement"
        ],
        "summary": "Vô hiệu hóa tài khoản người dùng theo mã định danh.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Mã định danh của người dùng.",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Vô hiệu hóa người dùng thành công."
          },
          "404": {
            "description": "Không tìm thấy người dùng."
          },
          "401": {
            "description": "Thiếu token hoặc token không hợp lệ."
          },
          "403": {
            "description": "Người dùng không có quyền quản trị."
          }
        }
      }
    },
    "/api/UserManagement/users/{id}/block": {
      "post": {
        "tags": [
          "UserManagement"
        ],
        "summary": "Chặn một người dùng theo mã định danh với lý do cụ thể.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Mã định danh của người dùng.",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "description": "Lý do chặn người dùng.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AdminBlockUserDto"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/AdminBlockUserDto"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/AdminBlockUserDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Chặn người dùng thành công."
          },
          "400": {
            "description": "Lý do chặn không hợp lệ."
          },
          "404": {
            "description": "Không tìm thấy người dùng."
          }
        }
      }
